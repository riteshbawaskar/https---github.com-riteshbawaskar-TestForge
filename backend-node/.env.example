# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=./testforge.db

# ── Security ───────────────────────────────────────────────────────────────────
ENCRYPTION_SECRET=changeme_set_in_dotenv_32chars!!

# ── LLM — set at least one ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# ── Embeddings — choose ONE provider ──────────────────────────────────────────
#
# Option A: OpenAI (best quality, needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
#
# Option B: Gemini (free tier, needs GEMINI_API_KEY)
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=text-embedding-004
#
# Option C: Local — no API key, uses @xenova/transformers (downloads ~90 MB once)
#   npm install @xenova/transformers
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# ── Qdrant vector DB ───────────────────────────────────────────────────────────
# Leave blank → uses Qdrant Cloud or local Docker
# For zero-infrastructure local mode: start qdrant with Docker or use cloud
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=           # needed for Qdrant Cloud

# ── File uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# ── RAG ────────────────────────────────────────────────────────────────────────
CHUNK_SIZE=1800
CHUNK_OVERLAP=200
RAG_TOP_K=5
